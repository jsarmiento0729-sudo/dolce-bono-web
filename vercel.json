{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/menu",
      "destination": "/menu.html"
    },
    {
      "source": "/ubicaciones",
      "destination": "/ubicaciones.html"
    },
    {
      "source": "/nosotros",
      "destination": "/nosotros.html"
    }
  ]
}
